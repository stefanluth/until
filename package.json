{
  "name": "until",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:property",
    "test:unit": "TZ=UTC node --test tests/unit",
    "test:property": "TZ=UTC node --test tests/properties",
    "test:coverage": "TZ=UTC node --test --experimental-test-coverage --test-coverage-include='app/_utils/**' tests/unit tests/properties",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "js-cookie": "3.0.8",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "fast-check": "4.10.2",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  }
}
