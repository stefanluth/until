# Local development database (matches docker-compose.yml), or a Neon
# connection string (use the pooled -pooler host with sslmode=require when
# deploying).
DATABASE_URL=postgresql://until:until@localhost:5432/until

# Optional: maximum pg pool connections per instance.
# PG_POOL_MAX=2

# Cookies are Secure automatically in production. Set false only when
# previewing a production build over plain HTTP.
# COOKIE_SECURE=false
